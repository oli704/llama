# Copy to .env and fill in. See README.md "Setup" for where each value comes from.

# Postgres. Pooled URL for the app, direct URL for `prisma migrate` (same value locally).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/llama"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/llama"

# Auth.js - generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=""

# SMTP for magic-link sign-in emails.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Llama <noreply@example.com>"

# Claude - taste profiles, suggestions and itineraries.
ANTHROPIC_API_KEY=""

# Optional: live flight prices on suggestions (Amadeus test tier).
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""

# Stripe - Full access subscription (use test-mode sk_test_ keys outside production).
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
